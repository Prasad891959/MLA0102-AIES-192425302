from queue import PriorityQueue
graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': [],
    'E': [],
    'F': []
}
h = {
    'A': 6,
    'B': 4,
    'C': 2,
    'D': 1,
    'E': 3,
    'F': 0
}
def search(start, goal):
    pq = PriorityQueue()
    pq.put((h[start], start))
    while not pq.empty():
        _, node = pq.get()
        print(node, end=" ")
        if node == goal:
            print("Goal Found")
            return
        for child in graph[node]:
            pq.put((h[child], child))
search('A', 'F')
