from queue import PriorityQueue
graph = {
    'A': [('B',1), ('C',4)],
    'B': [('D',2), ('E',5)],
    'C': [('F',1)],
    'D': [],
    'E': [('F',1)],
    'F': []
}
h = {
    'A':7, 'B':6, 'C':2,
    'D':1, 'E':1, 'F':0
}
def a_star(start, goal):
    pq = PriorityQueue()
    pq.put((0, start))
    cost = {start:0}
    parent = {start:None}
    while not pq.empty():
        _, node = pq.get()
        if node == goal:
            path = []
            while node:
                path.append(node)
                node = parent[node]
            print("Path:", path[::-1])
            print("Cost:", cost[goal])
            return
        for child, c in graph[node]:
            new = cost[node] + c
            if child not in cost:
                cost[child] = new
                parent[child] = node
                pq.put((new + h[child], child))

a_star('A','F')
