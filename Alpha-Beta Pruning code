def alpha_beta(depth, node, maximizing, values, alpha, beta, height):
    if depth == height:
        return values[node]

    if maximizing:
        best = float('-inf')

        for i in range(2):
            value = alpha_beta(
                depth + 1,
                node * 2 + i,
                False,
                values,
                alpha,
                beta,
                height
            )

            best = max(best, value)
            alpha = max(alpha, best)

            if alpha >= beta:
                break

        return best

    else:
        best = float('inf')

        for i in range(2):
            value = alpha_beta(
                depth + 1,
                node * 2 + i,
                True,
                values,
                alpha,
                beta,
                height
            )

            best = min(best, value)
            beta = min(beta, best)

            if alpha >= beta:
                break

        return best


values = [3, 5, 2, 9, 12, 5, 23, 23]

height = 3

result = alpha_beta(
    0, 0, True, values,
    float('-inf'),
    float('inf'),
    height
)

print("Best Value:", result)
